#!/bin/sh
# claude-direct - run Claude Code straight at api.anthropic.com, bypassing
# claude-router for this session. Claude Code keeps only the last --settings
# flag, so ours goes after the caller's arguments; a caller's own --settings
# is therefore dropped.
exec claude "$@" --settings '{"env":{"ANTHROPIC_BASE_URL":"https://api.anthropic.com"}}'
