{
  "name": "wovn-cli",
  "private": true,
  "bin": {
    "wovn": "./dist/wovn.mjs"
  },
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "ship:machine": "vp pack && mkdir -p ~/.local/bin && install -m 755 dist/wovn.mjs ~/.local/bin/wovn"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
