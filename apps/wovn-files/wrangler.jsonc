{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wovn-files",
  // Personal account (connorchev@gmail.com), NOT walton-ai - wovn.org lives here
  "account_id": "290536f56594ac82bc4bacde9af0e082",
  // The custom Start server entry: the file host runs ahead of the router
  // (docs/adr/0004).
  "main": "src/server.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  // Single host: files.wovn.org serves both public and private objects from
  // one bucket (visibility lives in object metadata; see docs/adr/0001).
  "routes": [{ "pattern": "files.wovn.org", "custom_domain": true }],
  "workers_dev": false,
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "wovn-files" }],
  // Client assets (the Vite plugin points this at the client build output).
  // run_worker_first keeps auth and R2 serving in front: the worker decides
  // when an asset is served.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  // Two Cloudflare Access apps on one team, each path-scoped: "wovn private
  // files" at files.wovn.org/login identifies Connor (ACCESS_AUD), "wovn
  // guest" at files.wovn.org/guest identifies anyone by one-time PIN
  // (GUEST_AUD, docs/adr/0005). The worker verifies both JWTs itself
  // (relayed via cookies), so these say which audience each cookie must
  // carry.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "connorchev.cloudflareaccess.com",
    "ACCESS_AUD": "469e2cf049d6c642d60160a7aa0ba5b4fdf1ae47638a648f8a878b98b44f6d1c",
    "GUEST_AUD": "1a86358f75d50d57b2f67c95ea157b2aeecc941745750c547ef905ef88384d23",
  },
  "observability": { "enabled": true },
}
