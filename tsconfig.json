{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "scripts/fleet/**/*.ts",
    "scripts/fleet/**/*.mjs",
    "tests/*.test.ts"
  ]
}
