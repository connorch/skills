{
  "name": "skills",
  "private": true,
  "type": "module",
  "scripts": {
    "fleet": "node scripts/fleet/cli.ts",
    "conductor:run": "node scripts/fleet/cli.ts sync",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write scripts/fleet tests/fleet.test.ts package.json tsconfig.json",
    "format:check": "prettier --check scripts/fleet tests/fleet.test.ts package.json tsconfig.json"
  },
  "dependencies": {
    "skills": "1.5.7",
    "yaml": "2.8.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.34.3"
}
