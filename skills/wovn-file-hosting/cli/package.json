{
  "name": "wovn-cli",
  "private": true,
  "scripts": {
    "build": "esbuild src/wovn.ts --bundle --platform=node --target=node20 --format=cjs --banner:js='#!/usr/bin/env node' --outfile=dist/wovn && chmod +x dist/wovn",
