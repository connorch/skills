    "@tanstack/react-start": "^1.168.50",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.34.0",
    "react": "^19.2.6",
