#!/bin/sh
# wovn - CLI for the files.wovn.org file host (see skills/file-upload).
#
#   wovn put [--private] [--name <filename>] <file...>   upload to immutable URLs, one printed per line
#   wovn put [--private] --at <remote-path> <file>       write to a stable path, overwriting; URL never changes
#   wovn rotate                                          rotate the upload token (file + Worker secret)
#
# --private uploads to private.wovn.org (Cloudflare Access-gated; only Connor
# can read) using the Access service token in ~/.config/wovn-files/access.env.
#
# Token resolution: ~/.config/wovn-files/token.txt first (canonical on this
# machine, survives rotation without a new shell), FILE_HOST_TOKEN env second
# (for machines that only have the env var).
set -eu

HOST="https://files.wovn.org"
PRIVATE_HOST="https://private.wovn.org"
TOKEN_FILE="$HOME/.config/wovn-files/token.txt"
ACCESS_ENV_FILE="$HOME/.config/wovn-files/access.env"
# Personal Cloudflare account (connorchev@gmail.com), where the wovn-files worker lives.
ACCOUNT_ID="290536f56594ac82bc4bacde9af0e082"

usage() {
  sed -n 's/^#   //p' "$0" >&2
  exit 1
}

token() {
  if [ -r "$TOKEN_FILE" ]; then
    cat "$TOKEN_FILE"
  elif [ -n "${FILE_HOST_TOKEN:-}" ]; then
    printf '%s' "$FILE_HOST_TOKEN"
  else
    echo "wovn: no token at $TOKEN_FILE and FILE_HOST_TOKEN is unset" >&2
    exit 1
  fi
}

put() {
  name=""
  at=""
  private=0
  while [ $# -gt 0 ]; do
    case "$1" in
    --private)
      private=1
      shift
      ;;
    --name)
      [ $# -ge 2 ] || usage
      name="$2"
      shift 2
      ;;
    --at)
      [ $# -ge 2 ] || usage
      at="$2"
      shift 2
      ;;
    *) break ;;
    esac
  done
  [ $# -ge 1 ] || usage
  [ -z "$name" ] || [ $# -eq 1 ] || { echo "wovn: --name only applies to a single file" >&2; exit 1; }
  [ -z "$at" ] || [ $# -eq 1 ] || { echo "wovn: --at only applies to a single file" >&2; exit 1; }
  [ -z "$at" ] || [ -z "$name" ] || { echo "wovn: --at already names the file; drop --name" >&2; exit 1; }

  if [ "$private" = 1 ]; then
    # Access service token: file with CF_ACCESS_CLIENT_ID / CF_ACCESS_CLIENT_SECRET lines.
    [ -r "$ACCESS_ENV_FILE" ] || { echo "wovn: --private needs $ACCESS_ENV_FILE" >&2; exit 1; }
    . "$ACCESS_ENV_FILE"
  else
    tok="$(token)"
  fi

  # POST mints an immutable dated key; PUT (--at) overwrites the exact path.
  for file in "$@"; do
    [ -r "$file" ] || { echo "wovn: cannot read $file" >&2; exit 1; }
    if [ -n "$at" ]; then
      method="PUT"
      path="$at"
    else
      method="POST"
      path="$(printf '%s' "${name:-$(basename "$file")}" | tr -c 'a-zA-Z0-9._-' '-')"
    fi
    if [ "$private" = 1 ]; then
      curl -sS --fail-with-body -X "$method" -T "$file" \
        -H "CF-Access-Client-Id: $CF_ACCESS_CLIENT_ID" \
        -H "CF-Access-Client-Secret: $CF_ACCESS_CLIENT_SECRET" \
        "$PRIVATE_HOST/$path"
    else
      curl -sS --fail-with-body -X "$method" -T "$file" -H "Authorization: Bearer $tok" "$HOST/$path"
    fi
  done
}

rotate() {
  new="$(openssl rand -hex 32)"
  # Server first: if the secret update fails, the local token stays valid.
  printf '%s' "$new" |
    CLOUDFLARE_ACCOUNT_ID="$ACCOUNT_ID" npx -y wrangler secret put FILE_HOST_TOKEN --name wovn-files
  umask 077
  mkdir -p "$(dirname "$TOKEN_FILE")"
  printf '%s\n' "$new" >"$TOKEN_FILE"
  echo "wovn: token rotated ($TOKEN_FILE and the Worker secret are updated)"
  echo "wovn: shells with a stale FILE_HOST_TOKEN env var need restarting; wovn itself reads the file"
}

case "${1:-}" in
put)
  shift
  put "$@"
  ;;
rotate)
  rotate
  ;;
*)
  usage
  ;;
esac
